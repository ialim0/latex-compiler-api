# Application Settings
PROJECT_NAME="LaTeX Compilation Service"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
WORKERS=4
DEBUG=True

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_POOL_SIZE=20

# Compiler Configuration
MAX_COMPILER_WORKERS=4
COMPILATION_TIMEOUT=30
OUTPUT_DIR="pdf_output"

# File Management
CLEANUP_THRESHOLD=1000
FILE_RETENTION_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Security
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL="INFO"
JSON_LOGS=True

# Monitoring
ENABLE_METRICS=True