# .env.example

# ------------------------------------------------------------
# Project Information
# ------------------------------------------------------------

# Name of the project
PROJECT_NAME="Compilation Service"

# Current version of the project
VERSION="1.0.0"

# API versioning prefix
API_V1_STR="/api/v1"

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------

# Host address where the server will run
HOST="0.0.0.0"

# Port number for the server
PORT=8000

# Number of worker processes for handling requests
WORKERS=4

# Enable or disable debug mode (True/False)
DEBUG=True

# ------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------

# Redis server URL
REDIS_URL="redis://localhost:6379"

# Size of the Redis connection pool
REDIS_POOL_SIZE=20

# ------------------------------------------------------------
# Compiler Configuration
# ------------------------------------------------------------

# Maximum number of compiler worker threads/processes
MAX_COMPILER_WORKERS=4

# Timeout for compilation tasks in seconds
COMPILATION_TIMEOUT=30

# ------------------------------------------------------------
# File Management
# ------------------------------------------------------------

# Directory where PDF outputs are stored
OUTPUT_DIR="pdf_output"

# Threshold for cleanup operations (e.g., number of files)
CLEANUP_THRESHOLD=1000

# Number of days to retain files before deletion
FILE_RETENTION_DAYS=7

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

# Maximum number of requests per minute per user
RATE_LIMIT_PER_MINUTE=100

# ------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------

# List of origins that are allowed to make cross-origin requests.
# Example: '["https://example.com", "https://anotherdomain.com"]'
CORS_ORIGINS='["*"]'  # Allows all origins. Replace "*" with specific domains for enhanced security.

# List of HTTP methods that are allowed for cross-origin requests.
# FastAPI requires explicit methods; "*" is not allowed.
CORS_ALLOW_METHODS='["GET", "POST", "PUT", "DELETE", "OPTIONS"]'

# List of HTTP headers that are allowed in cross-origin requests.
# "*" allows all headers.
CORS_ALLOW_HEADERS='["*"]'  # Alternatively, specify headers like ["Content-Type", "Authorization"]

# List of hosts that are allowed to serve the application.
# Similar to CORS_ORIGINS; often used for server-level host validation.
ALLOWED_HOSTS='["*"]'  # Replace "*" with specific hosts as needed.

# ------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------

# Logging level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Enable or disable JSON formatted logs (True/False)
JSON_LOGS=True

# ------------------------------------------------------------
# Metrics
# ------------------------------------------------------------

# Enable or disable Prometheus metrics instrumentation (True/False)
ENABLE_METRICS=True

# ------------------------------------------------------------
# Additional Notes
# ------------------------------------------------------------

# - Ensure that the OUTPUT_DIR exists and has appropriate read/write permissions.
# - Adjust CORS settings (`CORS_ORIGINS`, `CORS_ALLOW_METHODS`, `CORS_ALLOW_HEADERS`) according to your security requirements.
# - For production environments, it's recommended to restrict `CORS_ORIGINS` and `ALLOWED_HOSTS` to trusted domains.
# - The `DEBUG` mode should be set to `False` in production to avoid exposing sensitive information.
# - Review and adjust other configurations like `RATE_LIMIT_PER_MINUTE` based on your application's needs and expected traffic.
